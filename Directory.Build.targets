<Project>

	<PropertyGroup>
		<!-- Solution-wide version -->
		<Version>8.2.12</Version>
		<FileVersion>8.2.12.0</FileVersion>
		<AssemblyVersion>8.2.12.0</AssemblyVersion>
		<!-- Unified output folder -->
		<SimPeUnifiedOutDir Condition=" '$(SolutionDir)' != '' And '$(SolutionDir)' != '*Undefined*' ">$(SolutionDir)bin\$(Configuration)\</SimPeUnifiedOutDir>
		<!-- Suppress CA1416 platform-compatibility warnings — entire solution targets net8.0-windows -->
		<!-- Suppress legacy code warnings in old decompiled/ported code -->
		<NoWarn>$(NoWarn);CA1416;CA2200;CS0067;CS0162;CS0168;CS0169;CS0414;CS0436;CS0618;CS0649;CS8981;SYSLIB0003</NoWarn>
		<!-- Demote MSB3568 (duplicate resource names) and MSB3825 (BinaryFormatter in resx) to messages -->
		<MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3568;MSB3825</MSBuildWarningsAsMessages>
		<!-- Don't generate BinaryFormatter warnings from resx resources -->
		<GenerateResourceWarnOnBinaryFormatterUse>false</GenerateResourceWarnOnBinaryFormatterUse>
	</PropertyGroup>

	<Target Name="SimPeCopyToUnifiedBin" AfterTargets="Build" Condition=" '$(SimPeUnifiedOutDir)' != '' ">
		<!-- Ensure destination exists -->
		<MakeDir Directories="$(SimPeUnifiedOutDir)"
				 Condition=" '$(SimPeUnifiedOutDir)' != '' " />

		<!-- Copy main output (DLL or EXE) -->
		<Copy
		  SourceFiles="$(TargetPath)"
		  DestinationFolder="$(SimPeUnifiedOutDir)"
		  SkipUnchangedFiles="false"
		  Condition="Exists('$(TargetPath)')" />

		<!-- Copy the native EXE host for WinExe/Exe projects -->
		<Copy
		  SourceFiles="$(TargetDir)$(TargetName).exe"
		  DestinationFolder="$(SimPeUnifiedOutDir)"
		  SkipUnchangedFiles="false"
		  Condition=" '$(OutputType)' != 'Library' And Exists('$(TargetDir)$(TargetName).exe') " />

		<!-- Copy deps.json and runtimeconfig.json for exe projects -->
		<Copy
		  SourceFiles="$(TargetDir)$(TargetName).deps.json"
		  DestinationFolder="$(SimPeUnifiedOutDir)"
		  SkipUnchangedFiles="true"
		  Condition="Exists('$(TargetDir)$(TargetName).deps.json')" />
		<Copy
		  SourceFiles="$(TargetDir)$(TargetName).runtimeconfig.json"
		  DestinationFolder="$(SimPeUnifiedOutDir)"
		  SkipUnchangedFiles="true"
		  Condition="Exists('$(TargetDir)$(TargetName).runtimeconfig.json')" />

		<!-- Copy PDB if it exists -->
		<Copy
		  SourceFiles="$(TargetDir)$(TargetName).pdb"
		  DestinationFolder="$(SimPeUnifiedOutDir)"
		  SkipUnchangedFiles="true"
		  Condition="Exists('$(TargetDir)$(TargetName).pdb')" />

		<!-- Copy XML docs if they exist -->
		<Copy
		  SourceFiles="$(TargetDir)$(TargetName).xml"
		  DestinationFolder="$(SimPeUnifiedOutDir)"
		  SkipUnchangedFiles="true"
		  Condition="Exists('$(TargetDir)$(TargetName).xml')" />

		<!-- If this is a plugin, wizard, or exporter assembly, also copy to Plugins\
		     subfolder of the unified bin AND to SimPE.Main\bin\$(Configuration)\Plugins\
		     so devs who launch SimPE.Main.exe from its own bin folder see the full set.
		     ExporterLoader, PluginManager, ScannerRegistry, and WizardSelector all scan
		     Plugins\ for these specific *.plugin.dll / *.wizard.dll / *.exporter.dll
		     suffixes — DLLs landing only at the unified-bin root won't be picked up
		     (which is what caused "No exporter plugins available" for mesh export). -->
		<PropertyGroup>
			<_IsPluginOrWizard Condition=" $(AssemblyName.EndsWith('.plugin')) Or $(AssemblyName.EndsWith('.wizard')) Or $(AssemblyName.EndsWith('.exporter')) ">true</_IsPluginOrWizard>
			<_SimPeMainBin Condition=" '$(SolutionDir)' != '' And '$(SolutionDir)' != '*Undefined*' ">$(SolutionDir)SimPE.Main\bin\$(Configuration)\</_SimPeMainBin>
		</PropertyGroup>

		<MakeDir Directories="$(SimPeUnifiedOutDir)Plugins" Condition=" '$(_IsPluginOrWizard)' == 'true' " />
		<Copy SourceFiles="$(TargetPath)" DestinationFolder="$(SimPeUnifiedOutDir)Plugins"
		  SkipUnchangedFiles="true" Condition=" '$(_IsPluginOrWizard)' == 'true' And Exists('$(TargetPath)')" />
		<Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(SimPeUnifiedOutDir)Plugins"
		  SkipUnchangedFiles="true" Condition=" '$(_IsPluginOrWizard)' == 'true' And Exists('$(TargetDir)$(TargetName).pdb')" />

		<MakeDir Directories="$(_SimPeMainBin)Plugins" Condition=" '$(_IsPluginOrWizard)' == 'true' And '$(_SimPeMainBin)' != '' " />
		<Copy SourceFiles="$(TargetPath)" DestinationFolder="$(_SimPeMainBin)Plugins"
		  SkipUnchangedFiles="true" Condition=" '$(_IsPluginOrWizard)' == 'true' And '$(_SimPeMainBin)' != '' And Exists('$(TargetPath)')" />
		<Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(_SimPeMainBin)Plugins"
		  SkipUnchangedFiles="true" Condition=" '$(_IsPluginOrWizard)' == 'true' And '$(_SimPeMainBin)' != '' And Exists('$(TargetDir)$(TargetName).pdb')" />

		<!-- Plugin projects can ship sidecar data files (e.g. PJSE Coder's
		     GlobalStrings.package, which is referenced as
		     <None Include="pjse.coder.plugin\GlobalStrings.package"> with a
		     TargetPath of "Plugins\pjse.coder.plugin\GlobalStrings.package").
		     The CopyToOutputDirectory rule deposits them under
		     $(TargetDir)Plugins\<plugin-name>\* — but only the plugin DLL was
		     being copied to the unified bin's Plugins\ folder, leaving the
		     data files behind. Mirror the entire Plugins\ tree so any sidecar
		     content travels with its plugin. -->
		<ItemGroup>
			<_SimPePluginSidecars Include="$(TargetDir)Plugins\**\*.*" />
		</ItemGroup>
		<Copy SourceFiles="@(_SimPePluginSidecars)"
		  DestinationFiles="@(_SimPePluginSidecars->'$(SimPeUnifiedOutDir)Plugins\%(RecursiveDir)%(Filename)%(Extension)')"
		  SkipUnchangedFiles="true"
		  Condition=" '@(_SimPePluginSidecars)' != '' " />
		<Copy SourceFiles="@(_SimPePluginSidecars)"
		  DestinationFiles="@(_SimPePluginSidecars->'$(_SimPeMainBin)Plugins\%(RecursiveDir)%(Filename)%(Extension)')"
		  SkipUnchangedFiles="true"
		  Condition=" '@(_SimPePluginSidecars)' != '' And '$(_SimPeMainBin)' != '' " />

		<!-- For EXE/WinExe projects (SimPE.Main, Wizards of SimPe), also copy every
		     transitive runtime dependency (third-party DLLs, *.config, the runtimes\
		     native folder) from the project's bin into the unified bin. Without this,
		     bin\$(Configuration)\SimPE.Main.exe ships without WeifenLuo.WinFormsUI.Docking.dll
		     and the OpenTK assemblies and crashes at startup with FileNotFoundException
		     on a clean install (the per-project bin has them, but the unified one didn't).
		     Plugin DLLs are excluded — they live under Plugins\ and the dedicated copy
		     above already handles them. -->
		<ItemGroup Condition=" '$(OutputType)' != 'Library' ">
			<_SimPeAppDeps Include="$(TargetDir)*.dll" Exclude="$(TargetDir)*.plugin.dll;$(TargetDir)*.wizard.dll" />
			<_SimPeAppConfigs Include="$(TargetDir)*.config" />
			<_SimPeAppRuntimes Include="$(TargetDir)runtimes\**\*.*" />
		</ItemGroup>
		<Copy SourceFiles="@(_SimPeAppDeps)" DestinationFolder="$(SimPeUnifiedOutDir)"
		  SkipUnchangedFiles="true" Condition=" '$(OutputType)' != 'Library' " />
		<Copy SourceFiles="@(_SimPeAppConfigs)" DestinationFolder="$(SimPeUnifiedOutDir)"
		  SkipUnchangedFiles="true" Condition=" '$(OutputType)' != 'Library' " />
		<Copy SourceFiles="@(_SimPeAppRuntimes)"
		  DestinationFiles="@(_SimPeAppRuntimes->'$(SimPeUnifiedOutDir)runtimes\%(RecursiveDir)%(Filename)%(Extension)')"
		  SkipUnchangedFiles="true" Condition=" '$(OutputType)' != 'Library' " />

	</Target>

</Project>


