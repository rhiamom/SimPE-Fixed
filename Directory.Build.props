<Project>
  <PropertyGroup>
    <!-- AnyCPU — runs as 64-bit on 64-bit OS, eliminates x86-only native blocker -->
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
  </PropertyGroup>

  <!-- Release-only: strip absolute source paths from PDB (no leaked username /
       folder layout in stack traces) and embed the PDB inside the DLL so the
       distribution has no loose *.pdb files. Line numbers are preserved. -->
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <PathMap>$(MSBuildThisFileDirectory)=SimPE-Fixed/</PathMap>
    <DebugType>embedded</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>